# Database Configuration
# Options: 'mongodb', 'sqlite', or 'mysql'
DB_TYPE=mongodb

# MongoDB Connection String (Atlas or Local)
# Replace with your connection string from MongoDB Atlas
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/smart_agriculture?retryWrites=true&w=majority

# MySQL Configuration (Only required if DB_TYPE=mysql)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=smart_agriculture

# Server Configuration
PORT=5000
JWT_SECRET=smart_agri_secure_secret_key_123!

# MQTT Broker Configuration
MQTT_BROKER=mqtt://broker.emqx.io
